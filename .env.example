# Copy to .env.local and fill in real values. Never commit real values.

# Browserbase (cloud browser for scraping)
BROWSERBASE_API_KEY=${BROWSERBASE_API_KEY}
BROWSERBASE_PROJECT_ID=${BROWSERBASE_PROJECT_ID}
BROWSERBASE_CONTEXT_ID=${BROWSERBASE_CONTEXT_ID}

# Gemma via an OpenAI-compatible endpoint (point AI_BASE_URL at Ollama for local dev)
AI_PROVIDER=openai-compatible
AI_BASE_URL=${AI_BASE_URL}
AI_MODEL=gemma-4-26b-a4b-it
AI_API_KEY=${AI_API_KEY}
# Optional: sent as reasoning_effort. "minimal" turns off Gemma thinking on Google AI Studio (much faster).
AI_REASONING_EFFORT=

# EmbeddingGemma via Hugging Face
AI_EMBED_PROVIDER=huggingface
AI_EMBED_MODEL=google/embeddinggemma-300m
AI_EMBED_API_KEY=${AI_EMBED_API_KEY}

# ElevenLabs audio digest (optional)
ELEVENLABS_API_KEY=

# MongoDB Atlas
MONGODB_URI=${MONGODB_URI}
MONGODB_DB=slothscroll

# Digest
DIGEST_TIMEZONE=UTC

# Email (optional): Resend, or SMTP_* instead
EMAIL_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
